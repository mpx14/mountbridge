# /etc/sudoers.d/mountbridge
#
# Lets one user run the MountBridge root helper without a password. The helper
# (/usr/local/libexec/mountbridge-helper) validates every argument itself: it
# only mounts nfs/cifs, only under /mnt/mountbridge/<user>/, always with
# nosuid,nodev, and only unmounts its own mounts.
#
# Do NOT grant mount/umount directly: `mount` with wildcard arguments is
# equivalent to full root (e.g. `mount --bind` over /etc).
#
# install.sh substitutes %USER% and validates with `visudo -cf` before installing.

%USER% ALL=(root) NOPASSWD: /usr/local/libexec/mountbridge-helper
