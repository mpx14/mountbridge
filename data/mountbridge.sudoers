# /etc/sudoers.d/mountbridge
#
# Members of the 'mountbridge' group may run the MountBridge root helper without
# a password — and nothing else. The helper validates every argument itself: it
# only mounts nfs/cifs, only under /mnt/mountbridge/<user>/, always with
# nosuid,nodev, and only unmounts the caller's own mounts.
#
# Give a user NFS/SMB access:   sudo adduser <user> mountbridge
# (takes effect at their next login). SSHFS needs no root and no group.
#
# Do NOT grant mount/umount directly: `mount` with wildcard arguments is
# equivalent to full root (e.g. `mount --bind` over /etc).
#
# @HELPER@ is replaced at install time (.deb: /usr/libexec/mountbridge/…,
# install.sh: /usr/local/libexec/…).

%mountbridge ALL=(root) NOPASSWD: @HELPER@
