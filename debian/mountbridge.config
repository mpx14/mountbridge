#!/bin/sh
set -e

. /usr/share/debconf/confmodule

# Offer to add the user who is installing the package (via sudo or pkexec) to
# the 'mountbridge' group. Asked only on a fresh install or dpkg-reconfigure,
# only for a real non-root user who isn't a member yet, and only acted on if
# the question was actually shown — unattended installs add nobody.
#
# This script can run twice (apt's preconfigure, then again from postinst);
# the question is shown once, and the user is remembered for postinst.

if [ "$1" = configure ] && [ -n "$2" ]; then
    exit 0    # upgrade or reinstall: never ask again
fi

user="${SUDO_USER:-}"
if [ -z "$user" ] && [ -n "${PKEXEC_UID:-}" ]; then
    user="$(getent passwd "$PKEXEC_UID" | cut -d: -f1)"
fi
if [ -z "$user" ] || [ "$user" = root ] || ! getent passwd "$user" >/dev/null; then
    exit 0
fi
if id -nG "$user" 2>/dev/null | tr ' ' '\n' | grep -qx mountbridge; then
    exit 0
fi

db_subst mountbridge/add-installing-user user "$user"
if db_input high mountbridge/add-installing-user; then
    db_go || true
    db_set mountbridge/installing-user "$user"
fi

exit 0
